<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Runtime durci : sans cet entitlement, macOS ne présente jamais la demande
	  d'autorisation microphone et l'app ne peut pas ouvrir une entrée audio.
	  Aucun autre droit n'est accordé.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
